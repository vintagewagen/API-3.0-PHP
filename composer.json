{
  "name": "vintagewagen/api-3.0-php",
  "description": "Fork da integração com a API 3.0 da Cielo",
  "license": "MIT",
  "type": "library",
  "version": "1.4.10",
  "homepage": "https://github.com/vintagewagen/API-3.0-PHP",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "psr/log": "^2.0|^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1"
  },
  "suggest": {
    "monolog/monolog": "Allows more advanced logging of the application flow"
  },
  "autoload": {
    "psr-4": {
      "Cielo\\": "src/Cielo/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cielo\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=512M",
    "check": ["@composer validate --strict --no-check-version", "@analyse", "@test"]
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  }
}
